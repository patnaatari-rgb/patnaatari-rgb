# Copy this file to .env.local and fill in real values (never commit
# .env.local or any file with real keys - .gitignore already blocks it).
#
# Real values come from the Neon Postgres resource connected to this project
# via the Vercel Marketplace integration. Pull them with:
#   vercel env pull .env.local

DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Signs session cookies (app/lib/auth.ts). Generate your own:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=

# Used only by prisma/seed.ts to hash the initial login passwords - set your
# own values, never the real production passwords in this template file.
SEED_KVK_ADMIN_PASSWORD=
SEED_SUPER_ADMIN_PASSWORD=

# Bearer token Vercel Cron sends to /api/cron/auto-transfer-oft-fld (see
# vercel.json). Set it in the Vercel project's environment variables too:
# when it is unset the route runs without checking a token.
CRON_SECRET=
