/// Enriched to match the real report's "2.1.A Technical Parameter" section
/// AND the app's own 4-tab CFLD edit dialog (Technical Parameter / Economic
/// Parameters / Socio-economic Impact Parameters / Farmer's Perception) -
/// the 3 child models below correspond to that dialog's other 3 tabs.
model CfldTechnicalParameter {
  id                                String             @id @default(cuid())
  kvkId                             String
  kvk                               Kvk                @relation(fields: [kvkId], references: [id])
  zoneId                            String
  reportingYear                     Int
  /// Real field confirmed against the reference (atari-client.vercel.app, 2026-09-01) - "Reporting Year" is a real date picker there ("01-04-2026"), not a bare year number; `reportingYear` above stays a derived int (still needed by list columns/reports/filters elsewhere), this holds the actual picked date.
  reportingDate                     DateTime?
  /// Real field added 2026-08-28 (client reference, "Edit Technical Parameter" screen) - was missing entirely.
  month                             String?
  season                            String
  /// Real field confirmed against the reference (atari-client.vercel.app, 2026-09-01) - "CFLD Crop Type", the CfldCropMaster row's own `type` (e.g. "pulses"), distinct from `crop` itself (the crop name).
  cropType                          String?
  crop                              String
  cropDemonstrated                  String
  /// Real field confirmed against the reference (2026-09-01) - "Name of Variety" was shown filled-in on a real record, but had no backing column at all before this (the old dialog's Variety input silently never saved).
  variety                           String?
  areaHa                            Decimal            @db.Decimal(10, 2)
  numberOfFarmers                   Int
  /// Report 3.1.A "Target of CFLD Approved" (super-v2-prod.pdf p.55) - the sanctioned
  /// target the achievement (`areaHa` / demo count) is measured against; had no backing column.
  targetAreaHa                      Decimal?           @db.Decimal(10, 2)
  targetDemonstrations              Int?
  /// General/OBC/SC/ST x Male/Female breakdown - kept flexible rather than
  /// ~16 fixed columns, matching the report's own category grid.
  farmersByCategory                 Json?
  detailOfTechnologyDemonstrated    String
  existingFarmerPractice            String?
  yieldFarmerFieldQha               Decimal?           @db.Decimal(10, 2)
  yieldDemoMaxQha                   Decimal?           @db.Decimal(10, 2)
  yieldDemoMinQha                   Decimal?           @db.Decimal(10, 2)
  yieldDemoAvgQha                   Decimal?           @db.Decimal(10, 2)
  yieldGapKgHaDistrict              Decimal?           @db.Decimal(10, 2)
  yieldGapKgHaState                 Decimal?           @db.Decimal(10, 2)
  yieldGapKgHaPotential             Decimal?           @db.Decimal(10, 2)
  yieldGapMinimizedPercentDistrict  Decimal?           @db.Decimal(6, 2)
  yieldGapMinimizedPercentState     Decimal?           @db.Decimal(6, 2)
  yieldGapMinimizedPercentPotential Decimal?           @db.Decimal(6, 2)
  percentIncrease                   Decimal?           @db.Decimal(6, 2)
  districtYield                     Decimal?           @db.Decimal(10, 2)
  stateYield                        Decimal?           @db.Decimal(10, 2)
  potentialYield                    Decimal?           @db.Decimal(10, 2)
  /// Real fields confirmed against the reference (2026-09-01) - "Farmers' Training Photographs" and "Quality Action Photographs (field visits / technology demos)", each a multi-file upload, on the Technical Parameter tab. Both now store through ModuleImage (slots "cfld-training" / "cfld-action") so each photo carries a caption and flows to Module Images + Reports.
  status                            ProjectTrialStatus

  economicParameters   CfldEconomicParameter[]
  socioEconomicImpacts CfldSocioEconomicImpact[]
  farmersPerceptions   CfldFarmersPerception[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([zoneId])
  @@index([kvkId, reportingYear])
}

