  yiofpPercentFp            Decimal? @db.Decimal(6, 2)
  cocRsHaIp                 Decimal? @db.Decimal(12, 2)
  cocRsHaFp                 Decimal? @db.Decimal(12, 2)
  gmrRsHaIp                 Decimal? @db.Decimal(12, 2)
  gmrRsHaFp                 Decimal? @db.Decimal(12, 2)
  anmrRsHaIp                Decimal? @db.Decimal(12, 2)
  anmrRsHaFp                Decimal? @db.Decimal(12, 2)
  bcRatioIp                 Decimal? @db.Decimal(6, 2)
  bcRatioFp                 Decimal? @db.Decimal(6, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([zoneId])
  @@index([kvkId])
}

/// Real "Details Augmenting Rapeseed-Mustard Production... Input
/// Distribution" table (super-v2-prod.pdf p.80-81) is one row per input
/// item (Seeds/Equipment/Fertilizers/Plant Protection/Literature/Kisan
/// Mela/Other), each with a Unit+Quantity and a General/OBC/SC/ST x M/F/T
/// breakdown - a completely different real shape than the original
/// training/flds/awarenessCamps/distributionOfLiterature guess, which is
/// kept (not deleted) alongside the real fields below.
model DrmrActivity {
  id                       String   @id @default(cuid())
  kvkId                    String
  kvk                      Kvk      @relation(fields: [kvkId], references: [id])
  zoneId                   String
  startDate                DateTime
  endDate                  DateTime
  training                 String?
  flds                     String?
  awarenessCamps           String?
  distributionOfLiterature String?
  itemActivity             String?
  unit                     String?
  quantity                 Decimal? @db.Decimal(12, 2)
  farmersByCategory        Json?

  /// Report 3.10.B renders ONE DRMR submission as a fixed list of Item/Activity
  /// rows (Training / Area under FLDs / Awareness camps / Seeds / equipments /
  /// Fertilizers / PP chemicals / Distribution of Literature / Kisan Mela /
  /// Any other), each with its own Quantity + General/OBC/SC/ST x M/F block.
  items DrmrActivityItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([zoneId])
  @@index([kvkId])
}

/// One Item/Activity line of a DRMR submission (report 3.10.B / kvk-report 1.10.A).
model DrmrActivityItem {
  id               String       @id @default(cuid())
  drmrActivityId   String
  drmrActivity     DrmrActivity @relation(fields: [drmrActivityId], references: [id], onDelete: Cascade)
  zoneId           String
  /// Stable key: training | areaUnderFlds | awarenessCamps | seeds | smallEquipments | largeEquipments | fertilizers | ppChemicals | distributionOfLiterature | kisanMela | anyOther
  itemKey          String
  nameSpecification String?
  unit             String?
  quantity         Decimal?     @db.Decimal(14, 2)
  farmersByCategory Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([drmrActivityId])
  @@index([zoneId])
}

