// ATARI AMS - Prisma schema
// Modelled directly off two confirmed real sources, not guessed:
//  1. lib/navigation.ts (this app's own audited column lists per leaf)
//  2. the client's real 93-page "ATARI AMS REPORT" export (About KVK / Achievements /
//     Projects / Performance / Miscellaneous / Meetings), which this schema's module
//     grouping mirrors 1:1.
//
// Built phase by phase (client direction: audit-then-backend). This file currently
// covers Phase 1 - foundational reference data (Zone/State/District/Host/KVK/User)
// plus the "About KVK" report module (1.1-1.5). Achievements/Projects/Performance/
// Misc/Meetings follow in later phases.
//
// Multi-zone isolation: every KVK-owned table carries zoneId (denormalized from its
// KVK) so a zone's data can never leak into another zone's queries even by mistake -
// see the client's explicit multi-Super-Admin requirement.

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Auth / RBAC
// ---------------------------------------------------------------------------

/// The real enforcement level every authorization check in this app branches
/// on (requireSession, session.role, etc.) - renamed from `Role` (its field
/// name on User stays `role`, so no call site needed to change) now that
/// `Role` below is the human-facing, DB-backed role a user is actually
/// assigned in Role Management. Every one of the 9 real roles maps to one of
/// these 3 levels via Role.authLevel; a role with no defined enforcement
/// scope yet (State/District/Org Admin/User - see Role.scope) fails closed
/// to KVK_USER until a real spec says otherwise, rather than guessing it
/// should have broader access.
enum AuthLevel {
  SUPER_ADMIN
  KVK_ADMIN
  KVK_USER
}

/// What kind of data a role's scope fields (User.stateId/districtId/hostOrgId/kvkId)
/// narrow it to. Confirmed real roles (Role Management screenshots,
/// 2026-08-15): Super Admin/State Admin/District Admin/Org Admin/KVK Admin/
/// KVK User/State User/District User/Org User - 9 total, seeded as
/// `isSystemRole` rows. "Add Role" lets a Super Admin create further custom
/// roles on top of these.
enum RoleScope {
  SYSTEM
  STATE
  DISTRICT
  ORG
  KVK
}

model Role {
  id             String    @id @default(cuid())
  name           String
  /// snake_case machine name (client's own real "Add Role" form rule: "Use
  /// snake_case (e.g. state_admin, state_user)") - unique per zone so a
  /// Super Admin's custom roles in one zone can't collide with another's.
  slug           String
  hierarchyLevel Int
  scope          RoleScope
  authLevel      AuthLevel
  description    String?
  /// The 9 seeded base roles - can't be deleted or renamed from Role Management.
  isSystemRole   Boolean   @default(false)
  /// Null for the 9 system roles (shared across every zone); set for a
  /// custom role a Super Admin adds via "Add Role" in their own zone.
  zoneId         String?
  zone           Zone?     @relation(fields: [zoneId], references: [id])
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  users           User[]
  loginActivities LoginActivity[]
  dataChangeLogs  DataChangeLog[]
  targets         Target[]
  permissions     RolePermission[]

  @@unique([zoneId, slug])
  @@index([zoneId])
}

/// The 10 real permissions from the client's RBAC spec ("Roles based access
/// system 1.0", section 6.B) - what a role can DO within its scope, as
/// opposed to Role.scope (WHERE). A role's granted set is exactly the rows
/// present here; nothing implicit. Super Admin manages these via Manage
/// Permissions; a role with none granted defaults to no access beyond login.
enum PermissionType {
  VIEW
  ADD_CREATE
  EDIT
  DELETE
  APPROVE
  EXPORT
  MANAGE_USERS
  MANAGE_MASTERS
  MANAGE_FORMS
  MANAGE_PERMISSIONS
}

model RolePermission {
  id     String         @id @default(cuid())
  roleId String
  role   Role           @relation(fields: [roleId], references: [id], onDelete: Cascade)
  type   PermissionType

  @@unique([roleId, type])
  @@index([roleId])
}

model User {
  id           String            @id @default(cuid())
  /// Optional: the 3 real accounts seeded before Role Management existed
  /// (Super Admin + per-KVK admins) never captured a display name.
  name         String?
  username     String            @unique
  email        String?           @unique
  phone        String?
  passwordHash String
  role         AuthLevel
  roleId       String?
  assignedRole Role?             @relation(fields: [roleId], references: [id])
  /// Null for SUPER_ADMIN (a Super Admin owns a whole zone, not one KVK).
  kvkId        String?
  kvk          Kvk?              @relation(fields: [kvkId], references: [id])
  /// Scope fields for the 6 real roles beyond the original 3 (State/District/
  /// Org Admin/User) - which of these is set follows the assigned Role's
  /// own `scope`, same convention as kvkId above.
  stateId      String?
  state        State?            @relation(fields: [stateId], references: [id])
  districtId   String?
  district     District?         @relation(fields: [districtId], references: [id])
  hostOrgId    String?
  hostOrg      HostOrganization? @relation(fields: [hostOrgId], references: [id])
  /// Every user (including Super Admin) belongs to exactly one zone - this is the
  /// root of the isolation model, not just a convenience field.
  zoneId       String
  zone         Zone              @relation(fields: [zoneId], references: [id])
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  loginActivities LoginActivity[]
  dataChangeLogs  DataChangeLog[]
  moduleImages    ModuleImage[]
  notifications   Notification[]

  @@index([zoneId])
  @@index([kvkId])
  @@index([roleId])
  @@index([stateId])
  @@index([districtId])
  @@index([hostOrgId])
}

/// One row per successful login - powers the real "View Users Log Activity"
/// page (S.No/KVK Name/Name Of User/Activity/IP Address/Login Time) and the
/// Dashboard's Recent Log History card. username/role/kvkName are snapshotted
/// at write time (not just joined via userId/kvkId) so history stays readable
/// even if a user is later renamed or removed.
model LoginActivity {
  id       String  @id @default(cuid())
  /// Nullable + SetNull: deleting a User account must still be possible even
  /// after they've logged in before (the normal case for any real account
  /// being removed) - `username` below is already denormalized, so the log
  /// row stays fully readable even once this link is gone.
  userId   String?
  user     User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  username String
  /// Nullable: rows logged before Role Management existed have no Role row to point to.
  roleId   String?
  role     Role?   @relation(fields: [roleId], references: [id])

  kvkId   String?
  kvk     Kvk?    @relation(fields: [kvkId], references: [id])
  kvkName String?
  zoneId  String

  activity  String   @default("Login")
  ipAddress String?
  createdAt DateTime @default(now())

  @@index([zoneId])
  @@index([kvkId])
  @@index([userId])
}

enum DataChangeAction {
  CREATE
  UPDATE
  DELETE
}

/// Audit trail for Form Management and Masters records (security review,
/// 2026-09-22: Log History covered sign-ins only - creating, changing or
/// deleting a record left no trace of who, when and which record). Written
/// centrally from the 8 generic CRUD routes (leaf-record and master-record
/// create/update/delete, plus OFT/FLD mark-completed and transfer as an
/// UPDATE), not from inside each of the ~350 individual leaf handlers -
/// those already share one create/update/delete signature per registry, so
/// hooking the route layer covers every leaf without touching them.
///
/// `values` is a snapshot of what the browser submitted (create: the full
/// new record; update: the fields resubmitted by that form) - not a
/// database-verified before/after diff, since the generic routes have no
/// per-model knowledge of the row's previous state. Good enough to answer
/// "who changed this and to what", the stated need; a real before/after
/// diff would need per-model support inside leaf-record-registry.ts itself.
/// username/role/kvkName are snapshotted at write time, same convention as
/// LoginActivity, so a row stays readable after the user or KVK changes.
model DataChangeLog {
  id       String  @id @default(cuid())
  userId   String?
  user     User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  username String
  roleId   String?
  role     Role?   @relation(fields: [roleId], references: [id])

  kvkId   String?
  kvk     Kvk?    @relation(fields: [kvkId], references: [id])
  kvkName String?
  zoneId  String

  action    DataChangeAction
  /// The full recordPath the form submits (e.g. "projects/nicra/details", or
  /// "achievements/oft:transfer" for the one non-generic action logged).
  formPath  String
  /// The leaf's real label at write time (e.g. "Details"), resolved once
  /// here rather than re-derived from formPath on every read.
  formLabel String?
  recordId  String?
  values    Json?
  createdAt DateTime @default(now())

  @@index([zoneId, createdAt])
  @@index([kvkId])
  @@index([formPath])
}

/// Real backend for /targets (client request, "changes required 1.0.pdf"
/// 2026-08-25: "Add Target Option in KVK - the option should allow the KVK
/// user to enter and save the required target details"). Only the target
/// number is stored here - "Achieved" is always computed live from the
/// matching real submissions (Oft/Fld/Training/ExtensionActivity counts for
/// that kvkId+reportingYear), never a second manually-entered number that
/// could drift from what was actually submitted.
model Target {
  id            String @id @default(cuid())
  kvkId         String
  kvk           Kvk    @relation(fields: [kvkId], references: [id])
  zoneId        String
  reportingYear Int
  category      String // "OFT" | "FLD" | "Training" | "Extension Activity"
  targetValue   Int
  setByRole     Role   @relation(fields: [roleId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  roleId    String

  @@unique([kvkId, reportingYear, category])
  @@index([zoneId])
  @@index([kvkId])
}

/// Real backend for the Notifications page (client-documented flow: Super
/// Admin notifies KVKs - all or a chosen few; a KVK Admin notifies their own
/// KVK's users only; a KVK Admin's sends also surface to the Super Admin for
/// oversight). Also the real delivery mechanism behind Target's "notify the
/// KVK" behaviour (source="TARGET", client-confirmed 2026-08-29): a Super
/// Admin setting/updating a KVK's target auto-creates one of these.
model Notification {
  id     String @id @default(cuid())
  zoneId String
  zone   Zone   @relation(fields: [zoneId], references: [id])

  title   String
  message String

  /// Nullable + SetNull, same reasoning as LoginActivity.userId above -
  /// deleting a User must still be possible after they've sent a
  /// notification. senderName/senderRole are snapshotted at write time so
  /// history stays readable even once this link is gone.
  senderId      String?
  sender        User?     @relation(fields: [senderId], references: [id], onDelete: SetNull)
  senderName    String
  senderRole    AuthLevel
  /// Set only when a KVK_ADMIN sends (their own KVK) - lets the recipient
  /// KVK's users resolve "who sent this" and lets the Super Admin's
  /// oversight view group by KVK, without a live join through `sender`.
  senderKvkId   String?
  senderKvk     Kvk?      @relation(fields: [senderKvkId], references: [id])
  senderKvkName String?

  /// Which KVKs receive this - Super Admin sends only. Empty means every KVK
  /// in the zone ("Select All" convention, same as SelectKvksMultiDropdown/
  /// MultiFilterSelect elsewhere in this app). Unused for a KVK_ADMIN send,
  /// whose recipient is implicitly senderKvkId's own users.
  recipientKvkIds String[] @default([])

  /// "MANUAL" (compose form) | "TARGET" (auto-sent on a Super Admin
  /// Target set/update).
  source String @default("MANUAL")

  createdAt DateTime @default(now())

  @@index([zoneId])
  @@index([senderId])
  @@index([senderKvkId])
}

// ---------------------------------------------------------------------------
// Geography / reference masters (All Masters -> Basic Masters)
// ---------------------------------------------------------------------------

model Zone {
  id         String             @id @default(cuid())
  name       String             @unique
  states     State[]
  hostOrgs   HostOrganization[]
  institutes Institute[]
  kvks       Kvk[]
  users      User[]
  roles      Role[]

  masterListItems       MasterListItem[]
  oftSubjects           OftSubject[]
  fldSectors            FldSector[]
  cfldCropMasters       CfldCropMaster[]
  productTypeMasters    ProductTypeMaster[]
  croppingSystemMasters CroppingSystemMaster[]
  farmingSystemMasters  FarmingSystemMaster[]
  nicraCategoryMasters  NicraCategoryMaster[]
  fundingAgencyMasters  FundingAgencyMaster[]
  equipmentMasters      EquipmentMaster[]
  presentStatusOptions  PresentStatusOption[]
  trainingTypeMasters   TrainingTypeMaster[]
  notifications         Notification[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model State {
  id         String      @id @default(cuid())
  name       String
  zoneId     String
  zone       Zone        @relation(fields: [zoneId], references: [id])
  districts  District[]
  kvks       Kvk[]
  institutes Institute[]
  users      User[]
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@unique([zoneId, name])
  @@index([zoneId])
}

model District {
  id         String      @id @default(cuid())
  name       String
  stateId    String
  state      State       @relation(fields: [stateId], references: [id])
  /// Denormalized for fast zone-scoped queries without an extra join.
  zoneId     String
  kvks       Kvk[]
  institutes Institute[]
  users      User[]
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@unique([stateId, name])
  @@index([zoneId])
}

/// Institute Master (All Masters -> Basic Masters -> Institute Master) - kept
/// separate from Host Organization since the real reference lists them as
/// distinct masters, even though every KVK's Host Organization also happens to be
/// an institute in practice. `name` is picked from a real fixed set (ICAR/NGO/
/// CAU/SAU, per lib/masters.ts's INSTITUTE_MASTER_ROWS) via the real "Create
/// Institute" form's own dropdown, not freely typed - stateId/districtId
/// record which zone/state/district that instance of the institute type
/// belongs to (the reference's own real Create Institute form cascade,
/// confirmed 2026-08-26). Optional since the 4 existing rows predate this
/// cascade and were never assigned a state/district.
model Institute {
  id         String    @id @default(cuid())
  name       String
  zoneId     String
  zone       Zone      @relation(fields: [zoneId], references: [id])
  stateId    String?
  state      State?    @relation(fields: [stateId], references: [id])
  districtId String?
  district   District? @relation(fields: [districtId], references: [id])
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  kvks Kvk[]

  @@index([zoneId])
  @@index([stateId])
  @@index([districtId])
}

/// Report section 1.1.A.2 "Name and address of host organization" - real
/// columns confirmed from both lib/navigation.ts (host-master leaf) and the
/// report's own host organization table.
model HostOrganization {
  id                String   @id @default(cuid())
  name              String
  /// Real field confirmed from the client's own Host Organisation contact list (Host organisation-1.docx, 2026-08-25) - the earlier model had phone/email/address but no named contact person.
  directorExtension String?
  address           String?
  officePhone       String?
  mobilePhone       String?
  fax               String?
  email             String?
  zoneId            String
  zone              Zone     @relation(fields: [zoneId], references: [id])
  kvks              Kvk[]
  users             User[]
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([zoneId])
}

// ---------------------------------------------------------------------------
// KVK - the anchor entity. Everything else in the app scopes off this.
// ---------------------------------------------------------------------------

/// Report 1.1.A.1 "Name and address of KVK with phone, fax and e-mail" +
/// lib/navigation.ts's kvk-master / view-kvks leaves (Zone/State/Host
/// Org/District/KVK/Mobile/Email/Address/Year of Sanction).
model Kvk {
  id           String  @id @default(cuid())
  name         String
  address      String?
  officePhone  String?
  /// Separate from officePhone (the "Mobile Number" on the Edit KVK form) - the reference's own Edit KVK form has a distinct "Landline" text field (client report, 2026-09-04: entering a Landline and saving did nothing, because this had no column to save to).
  landline     String?
  fax          String?
  email        String?
  sanctionYear Int?

  zoneId      String
  zone        Zone             @relation(fields: [zoneId], references: [id])
  stateId     String
  state       State            @relation(fields: [stateId], references: [id])
  districtId  String
  district    District         @relation(fields: [districtId], references: [id])
  hostOrgId   String
  hostOrg     HostOrganization @relation(fields: [hostOrgId], references: [id])
  /// Which Institute Master category (ICAR/NGO/CAU/SAU) runs this KVK - optional (client request, 2026-08-27: no confirmed reference ever linked Institute to a KVK before this, so existing KVKs are left unset rather than guessed).
  instituteId String?
  institute   Institute?       @relation(fields: [instituteId], references: [id])

  users             User[]
  loginActivities   LoginActivity[]
  dataChangeLogs    DataChangeLog[]
  targets           Target[]
  bankAccounts      BankAccount[]
  staff             Staff[]
  staffTransfersIn  StaffTransfer[]  @relation("TransferTo")
