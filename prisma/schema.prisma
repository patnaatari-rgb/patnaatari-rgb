/// (farmer practice) columns - kept the original netReturn IP/FP fields
/// (their exact real-column mapping is unconfirmed) and added the 6 real
/// pairs alongside them rather than guessing a rename.
model DrmrDetail {
  id                        String   @id @default(cuid())
  kvkId                     String
  kvk                       Kvk      @relation(fields: [kvkId], references: [id])
  zoneId                    String
  varietiesUsedInIp         String
