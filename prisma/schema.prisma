// ---------------------------------------------------------------------------
// All Masters -> Other/OFT & FLD/Production Masters - the dropdown-source
// lookup tables that populate every form's Select fields (e.g. an FLD
// record's Category/Sub-category, a Staff record's Discipline). These were
// missing entirely from the schema until this pass - lib/navigation.ts's
// ALL_MASTERS tree confirms the exact real list.
// ---------------------------------------------------------------------------

/// Every single-column "Name" master (Job Type, Pay Level, Season, Equipment
/// Type, NICRA Dignitary Type, ...) shares one shape - one generic table
/// with a type discriminator instead of ~30 near-identical single-column
/// models.
enum MasterListType {
  STAFF_CATEGORY
  JOB_TYPE
  PAY_LEVEL
  PAY_SCALE
  SANCTIONED_POST
  DISCIPLINE
  BANK_ACCOUNT_TYPE
  SEASON
  UNIT
  CROP_TYPE
  IMPORTANT_DAY
  INFRASTRUCTURE_TYPE
  SOIL_WATER_ANALYSIS_TYPE
  EQUIPMENT_TYPE
  VEHICLE_TYPE
  ASSET_FUNDING_SOURCE
  NARI_ACTIVITY
  NARI_NUTRITION_GARDEN_TYPE
  NARI_CROP_CATEGORY
  NICRA_CATEGORY
  NICRA_SEED_FODDER_BANK
  NICRA_DIGNITARY_TYPE
  NICRA_PI_CO_PI_TYPE
  IMPACT_SPECIFIC_AREA
  ENTERPRISE_TYPE
  ACCOUNT_TYPE
  PROGRAMME_TYPE
  PPV_FRA_TRAINING_TYPE
  VIP_DIGNITARY
  FLD_ACTIVITY
  ARYA_ENTERPRISE
  TSP_SCSP_TYPE
  TSP_SCSP_ACTIVITY
  NATURAL_FARMING_ACTIVITY
  NATURAL_FARMING_SOIL_PARAMETER
  AGRI_DRONE_DEMONSTRATIONS_ON
  PRODUCT_CATEGORY
  TRAINING_CLIENTELE
  TRAINING_FUNDING_SOURCE
  EXTENSION_ACTIVITY_MASTER
  OTHER_EXTENSION_ACTIVITY_MASTER
  EVENTS_MASTER
  PUBLICATION_ITEM
  /// Client pointer, 2026-09-15: the new "Team" addon's own role dropdown (Nodal Officer / Associate Member), shared across every Project section's Team leaf.
  PROJECT_TEAM_ROLE
}

model MasterListItem {
  id     String         @id @default(cuid())
  type   MasterListType
  name   String
  zoneId String
  zone   Zone           @relation(fields: [zoneId], references: [id])
  /// "Mark as Other option" on the master create form - a row flagged here
  /// becomes the "Other" choice in every Form Management dropdown sourced
  /// from this master, and picking it opens a free-text input beside the
  /// dropdown for a custom value.
  isOther Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([zoneId, type, name])
  @@index([zoneId, type])
}

/// OFT Masters: Subject -> Thematic Area (real 2-level hierarchy).
model OftSubject {
  id      String  @id @default(cuid())
  name    String
  zoneId  String
  zone    Zone    @relation(fields: [zoneId], references: [id])
  /// Flags this row as the "Other" choice for any Form Management dropdown
  /// sourced from this master - picking it there opens a free-text input.
  isOther Boolean @default(false)

  thematicAreas OftThematicAreaMaster[]

  @@unique([zoneId, name])
  @@index([zoneId])
}

model OftThematicAreaMaster {
  id        String     @id @default(cuid())
  name      String
  subjectId String
  subject   OftSubject @relation(fields: [subjectId], references: [id])
  zoneId    String
  /// See OftSubject.isOther.
  isOther   Boolean    @default(false)

  @@unique([subjectId, name])
  @@index([zoneId])
}

/// FLD Masters: Sector -> Category -> Sub-category, plus a parallel
/// Sector -> Thematic Area branch - both confirmed as real, separate
/// hierarchies under Sector in lib/navigation.ts's oftFldMasters group.
model FldSector {
  id      String  @id @default(cuid())
  name    String
  zoneId  String
  zone    Zone    @relation(fields: [zoneId], references: [id])
  /// See OftSubject.isOther.
  isOther Boolean @default(false)

  thematicAreas FldThematicAreaMaster[]
  categories    FldCategoryMaster[]

  @@unique([zoneId, name])
  @@index([zoneId])
}

model FldThematicAreaMaster {
  id       String    @id @default(cuid())
  name     String
  sectorId String
  sector   FldSector @relation(fields: [sectorId], references: [id])
  zoneId   String
  /// See OftSubject.isOther.
  isOther  Boolean   @default(false)

  @@unique([sectorId, name])
  @@index([zoneId])
}

model FldCategoryMaster {
  id       String    @id @default(cuid())
  name     String
  sectorId String
  sector   FldSector @relation(fields: [sectorId], references: [id])
  zoneId   String
  /// See OftSubject.isOther.
  isOther  Boolean   @default(false)

  subCategories FldSubCategoryMaster[]

  @@unique([sectorId, name])
  @@index([zoneId])
}

model FldSubCategoryMaster {
  id         String            @id @default(cuid())
  name       String
  categoryId String
  category   FldCategoryMaster @relation(fields: [categoryId], references: [id])
  zoneId     String
  /// See OftSubject.isOther.
  isOther    Boolean           @default(false)

  crops CropMaster[]

  @@unique([categoryId, name])
  @@index([zoneId])
}

/// "Crop Master" under OFT & FLD Masters - name is qualified `CropMaster`
/// (not `Crop`) to stay unambiguous against the many plain `crop String`
/// fields used elsewhere in this schema for free-text crop names.
model CropMaster {
  id               String               @id @default(cuid())
  name             String
  unit             String?
  quantityDataType String?
  quantityRequired Boolean              @default(false)
  subCategoryId    String
  subCategory      FldSubCategoryMaster @relation(fields: [subCategoryId], references: [id])
  zoneId           String
  /// See OftSubject.isOther.
  isOther          Boolean              @default(false)

  @@unique([subCategoryId, name])
  @@index([zoneId])
}

/// CFLD Crop Master - season + type + crop name, its own flat list (not
/// nested under the FLD Sector/Category hierarchy above).
model CfldCropMaster {
  id       String @id @default(cuid())
  season   String
  type     String
  cropName String
  zoneId   String
  zone     Zone   @relation(fields: [zoneId], references: [id])

  @@index([zoneId])
}

/// Production Masters: Product Category -> Product Type -> Products.
model ProductTypeMaster {
  id           String  @id @default(cuid())
  categoryName String
  typeName     String
  zoneId       String
  zone         Zone    @relation(fields: [zoneId], references: [id])
  /// "Mark as Other option" - this row becomes the "Other" choice in every
  /// Form Management dropdown sourced from this master.
  isOther      Boolean @default(false)

  products ProductMaster[]

  @@unique([zoneId, categoryName, typeName])
  @@index([zoneId])
}

model ProductMaster {
  id                  String            @id @default(cuid())
  name                String
  unit                String?
  quantityDataType    String?
  quantityRequired    Boolean           @default(false)
  productTypeMasterId String
  productTypeMaster   ProductTypeMaster @relation(fields: [productTypeMasterId], references: [id])
  zoneId              String
  isOther             Boolean           @default(false)

  @@unique([productTypeMasterId, name])
  @@index([zoneId])
}

model CroppingSystemMaster {
  id       String  @id @default(cuid())
  season   String
  cropName String
  zoneId   String
  zone     Zone    @relation(fields: [zoneId], references: [id])
  isOther  Boolean @default(false)

