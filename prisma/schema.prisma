model NicraSubCategoryMaster {
  id         String              @id @default(cuid())
  name       String
  categoryId String
  category   NicraCategoryMaster @relation(fields: [categoryId], references: [id])
  zoneId     String

  @@unique([categoryId, name])
  @@index([zoneId])
}

/// Project Wise Budget Masters: Funding Agency -> Financial Project.
model FundingAgencyMaster {
  id     String @id @default(cuid())
  name   String
  zoneId String
  zone   Zone   @relation(fields: [zoneId], references: [id])

  financialProjects FinancialProjectMaster[]

  @@unique([zoneId, name])
  @@index([zoneId])
}

model FinancialProjectMaster {
  id              String              @id @default(cuid())
  projectName     String
  fundingAgencyId String
  fundingAgency   FundingAgencyMaster @relation(fields: [fundingAgencyId], references: [id])
  zoneId          String

  @@unique([fundingAgencyId, projectName])
  @@index([zoneId])
}

/// Training Master hierarchy: Training Type -> Training Area -> Training
/// Thematic Area (real 3-level hierarchy, confirmed columns in
/// lib/navigation.ts's trainingMaster group).
model TrainingTypeMaster {
  id     String  @id @default(cuid())
  name   String
  zoneId String
  zone   Zone    @relation(fields: [zoneId], references: [id])
  /// "Mark as Other option" (client direction, 2026-09-13) - same convention
  /// as every other master's isOther flag; this master never had one before,
  /// so there was no working "Other" here until now.
  isOther Boolean @default(false)

  areas TrainingAreaMaster[]

  @@unique([zoneId, name])
  @@index([zoneId])
}

model TrainingAreaMaster {
  id             String             @id @default(cuid())
  name           String
  trainingTypeId String
  trainingType   TrainingTypeMaster @relation(fields: [trainingTypeId], references: [id])
  zoneId         String
  isOther        Boolean            @default(false)

  thematicAreas TrainingThematicAreaMaster[]

  @@unique([trainingTypeId, name])
  @@index([zoneId])
}

model TrainingThematicAreaMaster {
  id             String             @id @default(cuid())
  name           String
  trainingAreaId String
  trainingArea   TrainingAreaMaster @relation(fields: [trainingAreaId], references: [id])
  zoneId         String
  isOther        Boolean            @default(false)

  @@unique([trainingAreaId, name])
  @@index([zoneId])
}

/// Resource Masters: Equipment (name + type label).
model EquipmentMaster {
  id            String @id @default(cuid())
  name          String
  equipmentType String
  zoneId        String
  zone          Zone   @relation(fields: [zoneId], references: [id])

  @@index([zoneId])
}

/// Vehicle/Equipment Present Status masters share this exact 4-column shape
/// (Status Code/Label/Hide in Next Year/Is Active) - one table, kind flag.
enum PresentStatusOptionKind {
  VEHICLE
  EQUIPMENT
}

model PresentStatusOption {
  id             String                  @id @default(cuid())
  kind           PresentStatusOptionKind
  statusCode     String
  statusLabel    String
  hideInNextYear Boolean                 @default(false)
  isActive       Boolean                 @default(true)
  zoneId         String
  zone           Zone                    @relation(fields: [zoneId], references: [id])

  @@unique([zoneId, kind, statusCode])
  @@index([zoneId])
}

// ---------------------------------------------------------------------------
// Module Images / Gallery (client spec: "Module Images UI.pdf") - real
// backend added 2026-08-28. A KVK uploads photographs against a Form
// Management category (categoryPath is a NavLeafPath.path string from
// lib/reports.ts's REPORT_FORM_LEAVES, not its own separate master list per
// the spec's own rule that new Form Management leaves must automatically
// become available here). Uploads land unpublished by default - the KVK
// decides when a photo goes live, Super Admin holds final override either
// way. Gallery (a separate page) only ever shows `published` rows.
// ---------------------------------------------------------------------------

model ModuleImage {
  id            String   @id @default(cuid())
  kvkId         String
  kvk           Kvk      @relation(fields: [kvkId], references: [id])
  zoneId        String
  categoryPath  String
  categoryLabel String
  reportingYear Int
  activityDate  DateTime
  caption       String
  imageUrl      String
  published     Boolean  @default(false)
  uploadedById  String?
  uploadedBy    User?    @relation(fields: [uploadedById], references: [id])
  /// Real source, 2026-09-02: images now attach at the end of the owning form itself (OFT/FLD/Training/Extension Activities to start) rather than only through the standalone Add Images page - this ties a row back to that specific form record so an edit/delete there can reconcile its own images without touching another record's. Null for the older standalone-upload rows, which have no owning record.
  formRecordId  String?
  /// Which photo section of the owning record this row belongs to. "" is the
  /// primary end-of-form "Photographs" section (main OFT/FLD/Training/Extension
  /// forms + every generic leaf). A record can also carry other captioned
  /// photo sections keyed by their own slot: "oft-result" (Edit OFT Result's
  /// Photographs), "cfld-training" / "cfld-action" (the two CFLD Technical
  /// Parameter photo cards). Reconciliation on save is scoped by
  /// (formRecordId, slot) so one section's save never wipes another's.
  slot          String   @default("")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([zoneId])
  @@index([kvkId, reportingYear])
  @@index([categoryPath])
  @@index([formRecordId])
  @@index([formRecordId, slot])
}
