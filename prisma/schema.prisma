  fundingAgencyName    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([zoneId])
  @@index([kvkId])
}

/// 1.3.B Land Details.
model Land {
  id     String @id @default(cuid())
  kvkId  String
  kvk    Kvk    @relation(fields: [kvkId], references: [id])
  zoneId String

  item        String
  description String?
  areaHa      Decimal @db.Decimal(10, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([zoneId])
  @@index([kvkId])
}

/// 1.3.C Staff Quarters Details - the report's own shape is one summary row
/// per KVK plus a 12-month x N-quarter occupancy grid; modelled as a parent
/// row + one child row per (month, quarter) cell rather than flattening the
/// grid into fixed columns, so it isn't locked to a max quarter count.
model StaffQuarters {
  id     String @id @default(cuid())
  kvkId  String
  kvk    Kvk    @relation(fields: [kvkId], references: [id])
  zoneId String

  dateOfCompletion DateTime?
  whetherCompleted Boolean?
  numberOfQuarters Int       @default(0)
  occupancyDetails String?
  remark           String?

  occupancy StaffQuarterOccupancy[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([zoneId])
  @@index([kvkId])
}

model StaffQuarterOccupancy {
  id              String        @id @default(cuid())
  staffQuartersId String
  staffQuarters   StaffQuarters @relation(fields: [staffQuartersId], references: [id])
  quarterNumber   Int
  month           Int // 1-12
  occupied        Boolean

  @@unique([staffQuartersId, quarterNumber, month])
}

/// 1.4.A/B Vehicles Details + Vehicle Status - kept as two tables since the
/// real report treats "status" (running cost, funding, present condition) as
/// a yearly-updated record against the same physical vehicle, not a fixed
/// attribute of it.
model Vehicle {
  id     String @id @default(cuid())
  kvkId  String
  kvk    Kvk    @relation(fields: [kvkId], references: [id])
  zoneId String

  /// KVK-report 1.4.A/1.4.B "Vehicle Type" column (Motor Cycle / Tractor / Jeep ...).
  vehicleType    String?
  name           String
  registrationNo String
  yearOfPurchase Int
  cost           Decimal @db.Decimal(12, 2)
  /// Reference /create-vehicle captures the vehicle's current Total Run and
  /// Present Status on the master row; /view-vehicle then lists them. The
  /// yearly VehicleStatus keeps its own per-year values for 1.4.B.
  totalRun        Decimal? @db.Decimal(12, 2)
  presentStatus   String?
  /// Only meaningful when presentStatus is "Repairing" - the form field is
  /// hidden otherwise (see MasterColumn.showWhen).
  repairingCost   Decimal? @db.Decimal(12, 2)
  sourceOfFunding String?

  statuses VehicleStatus[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([zoneId])
  @@index([kvkId])
}

model VehicleStatus {
  id            String   @id @default(cuid())
  vehicleId     String
  vehicle       Vehicle  @relation(fields: [vehicleId], references: [id])
  zoneId        String
  reportingYear Int
  totalRunKmHrs Decimal? @db.Decimal(12, 2)
  presentStatus String? // Working / Repairing / ...
  repairingCost Decimal? @db.Decimal(12, 2)
  fundingSource String?
  fundingAgency String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([vehicleId, reportingYear])
  @@index([zoneId])
}

/// 1.5.A/B Equipments Details + Equipment Status - same yearly-status pattern
/// as Vehicles.
model Equipment {
  id     String @id @default(cuid())
  kvkId  String
  kvk    Kvk    @relation(fields: [kvkId], references: [id])
  zoneId String

  /// KVK-report 1.5.A/1.5.B "Equipment Type" column (Farm Implements/Machinery / IT ...).
  equipmentType  String?
  name           String
  yearOfPurchase Int
  cost           Decimal @db.Decimal(12, 2)
  /// Reference /create-equipment captures Present Status + Source of fund on
  /// the equipment master itself; the yearly Equipment Details list then just
  /// shows Source of fund (it is not re-entered per year).
  presentStatus  String?
  sourceOfFund   String?
  /// Only meaningful when presentStatus is "Repairing" - the form field is
  /// hidden otherwise (see MasterColumn.showWhen).
  repairingCost  Decimal? @db.Decimal(12, 2)

  statuses EquipmentStatus[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([zoneId])
  @@index([kvkId])
}

/// "Farm Implement Details" - a standalone About-KVK leaf on atariams.org
/// (/view-implement, /create-implement). Same shape as Equipment (name / year
/// / cost) plus a free-text present status and source of fund.
model FarmImplement {
  id             String  @id @default(cuid())
  kvkId          String
  kvk            Kvk     @relation(fields: [kvkId], references: [id])
  zoneId         String
  name           String
  yearOfPurchase Int?
  totalCost      Decimal? @db.Decimal(12, 2)
  presentStatus  String?
  sourceOfFund   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([zoneId])
  @@index([kvkId])
}

model EquipmentStatus {
  id            String    @id @default(cuid())
  equipmentId   String
  equipment     Equipment @relation(fields: [equipmentId], references: [id])
  zoneId        String
  reportingYear Int
  sourceOfFund  String?
  fundingAgency String?
  presentStatus String?
  /// Only meaningful when presentStatus is "Repairing".
  repairingCost Decimal?  @db.Decimal(12, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([equipmentId, reportingYear])
  @@index([zoneId])
}

// ---------------------------------------------------------------------------
// Form Management -> Achievements
//
// Columns below are taken 1:1 from lib/navigation.ts's `achievements` group
// (each leaf re-confirmed live against atariams.org, not from the older
// AMS User Manual). Every table follows the same kvkId + denormalized
// zoneId scoping pattern as the About KVK module above.
// ---------------------------------------------------------------------------

enum TrialStatus {
  ONGOING
  COMPLETED
  /// Real third status (client spec, "Pointers for super admin 24 aug.pdf"): manually set when a KVK transfers an Ongoing OFT/FLD to the next reporting year - the original row stays visible under its real year with this status, a new ONGOING copy is created under reportingYear+1.
  TRANSFERRED
}

/// Technical Achievement Summary is a matrix report (year x section x metric
/// x caste-category), not a flat list - modelled as one fact row per cell
/// rather than guessing a fixed wide-column shape, since the UI component
/// (technical-achievement-summary.tsx) renders an open-ended set of metric
/// rows per section that isn't fully enumerable from the nav tree alone.
model TechnicalAchievementSummaryEntry {
  id            String  @id @default(cuid())
  kvkId         String
  kvk           Kvk     @relation(fields: [kvkId], references: [id])
  zoneId        String
  reportingYear Int
  sectionCode   String // e.g. "oft", "fld", "training", "extension"
  metricCode    String // e.g. "no_of_trials", "no_of_farmers_participated"
  casteCategory String? // e.g. "SC", "ST", "OBC", "General" - null where a metric isn't caste-split
  value         Decimal @db.Decimal(14, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([kvkId, reportingYear, sectionCode, metricCode, casteCategory])
  @@index([zoneId])
}

/// Enriched to match the real per-record report detail (ATARI AMS Report
/// section "1.2.A KVK Wise OFT Details"), not just the list-view columns -
/// the real add form/report carries far more fields than the table shows.
model Oft {
  id            String @id @default(cuid())
  kvkId         String
  kvk           Kvk    @relation(fields: [kvkId], references: [id])
  zoneId        String
  reportingYear Int

  /// Real fields confirmed against the reference (atari-client.vercel.app, 2026-08-15 screenshots) - "Season", "OFT Subject" (distinct from Discipline), and "Source of Funding" were missing entirely; `fundingAgency` stays as-is (a separate real field on the same form, "Funding Agency Name").
  season          String?
  oftSubject      String?
  sourceOfFunding String?
  /// Real field confirmed against the reference - "No. of location".
  noOfLocation    Int?
  /// Report groups each OFT under a discipline heading, e.g. "OFT
  /// (Agronomy)", "OFT (Animal Science)", "OFT (Fisheries)", "OFT (Home
  /// Science)", "OFT (Agricultural Extension)".
  discipline                  String
  staff                       String
  thematicArea                String
  trialOnForm                 String
  problemDiagnosed            String?
  sourceOfTechnology          String?
  productionSystem            String?
  performanceIndicators       String?
  finalRecommendation         String?
  constraintsIdentified       String?
  farmersParticipationProcess String?
  /// "Remark" on the real Edit OFT Result page (atari-client.vercel.app, 2026-09-02) - separate from `resultSummary` ("Result"), which sits right above it on the same page.
  remark                      String?
  quantity                    Decimal?    @db.Decimal(10, 2)
  unit                        String?
  noOfTrialReplicationFarmer  Int?
  startMonth                  DateTime?
  endMonth                    DateTime?
  criticalInput               String?
  costOfOft                   Decimal?    @db.Decimal(12, 2)
  fundingAgency               String?
  resultSummary               String?
  /// Real reference (atari-client.vercel.app, 2026-09-02): "Photographs" (images only) and "Supplementary Datasheets" (PDF/Image/Excel/Word) upload fields on the Edit OFT Result page, each multi-file. The Photographs section now stores through ModuleImage (slot "oft-result") so every photo carries a caption and flows to Module Images + Reports like every other form's photos; Supplementary Datasheets (documents, not images) stay a plain URL list here.
  supplementaryDatasheetUrls  String[] @default([])
  /// "Dynamic Result Tables" on the same page - a user-defined set of tables, each with its own editable column names and rows (not a fixed schema, confirmed against the real reference: "Add Table"/"Add Column"/"Add Row" all freely add to this structure). Stored as JSON since the table shape itself is user-defined, not a fixed set of columns - see lib/oft-result-tables.ts for the parsed shape.
  resultTablesJson            String?
  status                      TrialStatus

  /// "Farmers Details" block on the real Add OFT form (General_M/F, OBC_M/F,
  /// SC_M/F, ST_M/F) - same shape as CfldExtensionActivity's breakdown.
  generalMale   Int @default(0)
  generalFemale Int @default(0)
  obcMale       Int @default(0)
  obcFemale     Int @default(0)
  scMale        Int @default(0)
  scFemale      Int @default(0)
  stMale        Int @default(0)
  stFemale      Int @default(0)

  technologyOptions OftTechnologyOption[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([zoneId])
  @@index([kvkId, reportingYear])
}

/// "Details of technologies selected for assessment/refinement" - one row
/// per option (Farmer Practice, TO1, TO2, ...).
model OftTechnologyOption {
  id          String @id @default(cuid())
  oftId       String
  oft         Oft    @relation(fields: [oftId], references: [id], onDelete: Cascade)
  zoneId      String
  label       String // "Farmer Practice", "TO1", "TO2", ...
  description String

  @@index([zoneId])
  @@index([oftId])
}

model Fld {
  id                     String      @id @default(cuid())
  kvkId                  String
  kvk                    Kvk         @relation(fields: [kvkId], references: [id])
  zoneId                 String
  reportingYear          Int
  startDate              DateTime?
  endDate                DateTime?
  /// Real fields confirmed against the reference (atari-client.vercel.app, 2026-08-15 screenshots) - "Name of SMS/KVK Head" (a real staff dropdown), "Season", "Sector" (parent of Category, matches the real FLD Sector Master already used by All Masters' own Sector/Category/Sub-category/Crop cascade), and "Thematic Area" (sourced from the real fld-thematic-area master, cascading off Sector like FLD Thematic Area Master already does) were missing entirely.
  staff                  String?
  season                 String?
  sector                 String?
  thematicArea           String?
  category               String
  subCategory            String
  /// "Crop/Animal/Enterprise" - the real fourth cascade level (All Masters' own Crop Master, sourced from CropMaster rows under the selected Sub Category), distinct from `technologyDemonstrated` ("Name of Technology Demonstrated (FLD Name)").
  cropAnimalEnterprise   String?
  technologyDemonstrated String
  /// Real fields confirmed against the reference - "No of demonstration", "Unit", "Quantity", and the Farmers Details demographic breakdown (same General/OBC/SC/ST x Male/Female shape as Oft's own).
  noOfDemonstration Int?
  unit              String?
  quantity          Decimal?    @db.Decimal(10, 2)
  generalMale       Int         @default(0)
  generalFemale     Int         @default(0)
  obcMale           Int         @default(0)
  obcFemale         Int         @default(0)
  scMale            Int         @default(0)
  scFemale          Int         @default(0)
  stMale            Int         @default(0)
  stFemale          Int         @default(0)
  status                 TrialStatus

  /// Real "Add Result" / "Edit FLD" tab confirmed live 2026-08-15 ("project
  /// over" reference) - Yield (Demo/Check/%Increase auto-calc) + Economics
  /// (Gross Cost/Return/Net Return auto-calc/BCR auto-calc), same shape as
  /// FldDemonstrationDetail's own fields but stored directly on Fld since
  /// this is a real single "one result per FLD" feature (that separate
  /// model serves the multi-row Form Summary report breakdown instead).
  yieldDemoQha    Decimal? @db.Decimal(10, 2)
  yieldCheckQha   Decimal? @db.Decimal(10, 2)
  percentIncrease Decimal? @db.Decimal(6, 2)
  grossCostDemo   Decimal? @db.Decimal(12, 2)
  grossReturnDemo Decimal? @db.Decimal(12, 2)
  netReturnDemo   Decimal? @db.Decimal(12, 2)
  bcrDemo         Decimal? @db.Decimal(6, 2)

  extensionTrainings   FldExtensionTraining[]
  technicalFeedback    FldTechnicalFeedback[]
  demonstrationDetails FldDemonstrationDetail[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([zoneId])
  @@index([kvkId, reportingYear])
}

/// Report section "1.3.C Details of Front-Line Demonstration" - one row per
/// crop/item within a sector (Crop Production/Horticultural Crops/Livestock
/// & Fisheries/Other Enterprises/Women Empowerment/Farm Implements and
/// Machinery/Crop Hybrid Varieties). Economics fields are nullable because
/// the Farm Implements variant reports labor/cost reduction instead of
/// BCR-style economics, and Crop Hybrid Varieties sometimes reports no
/// economics at all - confirmed from the real report, not guessed.
model FldDemonstrationDetail {
  id     String @id @default(cuid())
  fldId  String
  fld    Fld    @relation(fields: [fldId], references: [id])
  zoneId String

  sector                 String
  cropOrItem             String
  thematicArea           String?
  technologyDemonstrated String?
  noOfDemonstrations     Int
  noOfFarmers            Int
  areaHa                 Decimal @db.Decimal(10, 2)

  yieldDemoQha    Decimal? @db.Decimal(10, 2)
  yieldCheckQha   Decimal? @db.Decimal(10, 2)
  percentIncrease Decimal? @db.Decimal(6, 2)

  grossCostDemo    Decimal? @db.Decimal(12, 2)
  grossReturnDemo  Decimal? @db.Decimal(12, 2)
  netReturnDemo    Decimal? @db.Decimal(12, 2)
  bcrDemo          Decimal? @db.Decimal(6, 2)
  grossCostCheck   Decimal? @db.Decimal(12, 2)
  grossReturnCheck Decimal? @db.Decimal(12, 2)
  netReturnCheck   Decimal? @db.Decimal(12, 2)
  bcrCheck         Decimal? @db.Decimal(6, 2)

  laborReductionManDays Decimal? @db.Decimal(10, 2)
  costReductionRs       Decimal? @db.Decimal(12, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([zoneId])
  @@index([fldId])
}

model FldExtensionTraining {
