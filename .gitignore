# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files - real secrets never committed; .env.example is the tracked template
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# generated Prisma client - regenerated by `postinstall` / `prisma generate`
/lib/generated/prisma

# internal planning docs (not for public repo)
/docs

# real client/government data stays local + in the database only, never in the repo
/zip-extract
prisma/*-seed-data*
prisma/*-sample*
prisma/*real-data*

# one-off local-only scripts (credentials / PII / machine-specific paths)
scripts/*.local.*
scripts/_tmp*

# editor
.vscode/
.idea/

# Claude Code local state - never push
.claude/

# local browser-testing artifacts (screenshots/snapshots, not project content)
/.playwright-mcp

# AI-IDE agent-skill docs auto-installed by third-party CLIs (Vercel/Neon/Prisma) -
# reference docs for coding assistants, not app code; never part of this repo
.agents/
.windsurf/
.cursor/
skills-lock.json
.playwright-mcp/

.env*
